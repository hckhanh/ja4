{
  "name": "@hckhanh/ja4",
  "version": "1.0.1",
  "description": "Parse JA4 TLS fingerprint strings into structured objects",
  "keywords": [
    "fingerprint",
    "ja4",
    "ja4+",
    "network",
    "parser",
    "security",
    "tanstack-intent",
    "tls"
  ],
  "homepage": "https://docs.khanh.id/ja4",
  "bugs": {
    "url": "https://github.com/hckhanh/ja4/issues"
  },
  "license": "MIT",
  "author": "Khánh Hoàng",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hckhanh/ja4.git"
  },
  "files": [
    "dist",
    "skills",
    "!skills/_artifacts"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "bench": "vitest bench --config vitest.bench.config.mts --run",
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "release": "bumpp",
    "validate:skills": "intent validate skills",
    "prepublishOnly": "vp run build",
    "prepare": "vp config && skills-npm"
  },
  "devDependencies": {
    "@codspeed/vitest-plugin": "6.1.0",
    "@tanstack/intent": "0.5.6",
    "@types/node": "25.9.9",
    "@typescript/native-preview": "7.0.0-dev.20260612.1",
    "bumpp": "11.1.0",
    "skills-npm": "1.2.1",
    "typescript": "6.0.3",
    "vite": "catalog:",
    "vite-plus": "0.2.9",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.28.7"
}
